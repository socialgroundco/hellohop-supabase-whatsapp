{
  "lock": {
    "path": "deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "tasks": {
    "test": "deno test --cached-only --no-remote --no-npm --deny-net --allow-read=.,/tmp --allow-write=/tmp --allow-run=git tests",
    "typecheck": "deno check --no-remote --no-npm supabase/functions/*/index.ts tests/*.test.ts scripts/*.ts",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "proof": "deno run --cached-only --no-remote --no-npm --deny-net --allow-read --allow-write --allow-run=deno,git scripts/prove-injections.ts",
    "build": "deno check --no-remote --no-npm supabase/functions/*/index.ts"
  },
  "fmt": {
    "exclude": [
      "supabase/functions/_shared/verify.ts",
      "fixtures/"
    ],
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      "supabase/functions/_shared/verify.ts"
    ]
  },
  "test": {
    "include": [
      "tests/*.test.ts"
    ]
  },
  "name": "hellohop-supabase-whatsapp",
  "license": "MIT",
  "repository": "github:socialgroundco/hellohop-supabase-whatsapp",
  "description": "Supabase Edge Functions on HelloHop's API: signed WhatsApp messages into a table, text sending from a backend."
}
